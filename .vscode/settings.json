{
    "java.checkstyle.configuration": "${workspaceFolder}/config/checkstyle/checkstyle.xml",
    "java.checkstyle.version": "13.8.0",
    "json.schemas": [
        {
            "fileMatch": [
                "/jscene3d-project-runtime/src/test/resources/META-INF/jscene3d/extension.json"
            ],
            "url": "./jscene3d-project/src/main/resources/META-INF/jscene3d/project/extension-1.schema.json"
        }
    ],
    "[java]": {
        "editor.formatOnSave": false
    },
    "files.exclude": {
        "**/target": true,
        "**/target_test-classes": true
    },
    "files.watcherExclude": {
        "**/target/**": true,
        "**/target_test-classes/**": true,
        "**/logs/**": true
    },
    "search.exclude": {
        "**/target": true,
        "**/target_test-classes": true,
        "**/logs": true,
        "**/*.log": true
    }
}
