{
  "schemaVersion": 1,
  "id": "io.github.glynch.jscene3d.doom",
  "version": "0.1.0-SNAPSHOT",
  "engineRequires": ">=0.1.0-SNAPSHOT <0.2.0",
  "displayName": "JScene3D Doom Content",
  "types": [
    {
      "id": "io.github.glynch.jscene3d.doom/maps",
      "typeVersion": 2,
      "scope": "importer",
      "displayName": "Classic Doom Maps"
    }
  ],
  "components": [
    {
      "id": "io.github.glynch.jscene3d.doom/door",
      "typeVersion": 1,
      "displayName": "Doom Door",
      "description": "Moves explicitly published door geometry and collision using classic Doom timing.",
      "updatePhases": ["before-physics", "after-physics"],
      "providedCapabilities": ["io.github.glynch.jscene3d.doom/door"],
      "properties": [
        {
          "id": "transform",
          "valueKind": "component_target",
          "required": true,
          "displayName": "Transform",
          "description": "Explicit generated transform moved with the door."
        },
        {
          "id": "closed-height",
          "valueKind": "number",
          "required": true,
          "displayName": "Closed Height",
          "description": "Closed local Y position in world units."
        },
        {
          "id": "open-height",
          "valueKind": "number",
          "required": true,
          "displayName": "Open Height",
          "description": "Open local Y position in world units."
        },
        {
          "id": "speed",
          "valueKind": "number",
          "required": true,
          "displayName": "Speed",
          "description": "Vertical movement speed in world units per second."
        },
        {
          "id": "hold-open-seconds",
          "valueKind": "number",
          "required": true,
          "displayName": "Hold Open",
          "description": "Seconds to hold before closing, or zero to remain open."
        },
        {
          "id": "profile",
          "valueKind": "text",
          "required": true,
          "displayName": "Profile",
          "description": "Imported semantic door profile used by presentation components."
        }
      ],
      "actions": [
        {
          "id": "obstruction-entered",
          "payload": {
            "type": "io.github.glynch.jscene3d.physics3d/collision-overlap-3d",
            "typeVersion": 1
          },
          "displayName": "Obstruction Entered",
          "description": "Receives a precise overlap when a character enters the generated closing boundary."
        },
        {
          "id": "obstruction-exited",
          "payload": {
            "type": "io.github.glynch.jscene3d.physics3d/collision-overlap-3d",
            "typeVersion": 1
          },
          "displayName": "Obstruction Exited",
          "description": "Receives a precise overlap when a character leaves the generated closing boundary."
        }
      ]
    },
    {
      "id": "io.github.glynch.jscene3d.doom/floor",
      "typeVersion": 1,
      "displayName": "Doom Moving Floor",
      "description": "Moves explicitly published floor geometry and collision using imported Doom linedef semantics.",
      "updatePhases": ["before-physics"],
      "providedCapabilities": ["io.github.glynch.jscene3d.doom/floor"],
      "properties": [
        {
          "id": "transform",
          "valueKind": "component_target",
          "required": true,
          "displayName": "Transform",
          "description": "Explicit generated transform moved with the floor."
        },
        {
          "id": "raised-height",
          "valueKind": "number",
          "required": true,
          "displayName": "Raised Height",
          "description": "Original local Y position in world units."
        },
        {
          "id": "lowered-height",
          "valueKind": "number",
          "required": true,
          "displayName": "Lowered Height",
          "description": "Terminal local Y position in world units."
        },
        {
          "id": "speed",
          "valueKind": "number",
          "required": true,
          "displayName": "Speed",
          "description": "Vertical movement speed in world units per second."
        },
        {
          "id": "profile",
          "valueKind": "text",
          "required": true,
          "displayName": "Profile",
          "description": "Imported semantic moving-floor profile."
        }
      ],
      "actions": [
        {
          "id": "trigger-entered",
          "payload": {
            "type": "io.github.glynch.jscene3d.physics3d/collision-overlap-3d",
            "typeVersion": 1
          },
          "displayName": "Trigger Entered",
          "description": "Receives the player-only overlap emitted by a generated walk-over trigger."
        }
      ]
    }
  ]
}
