          "required": true,
          "displayName": "Things"
        },
        {
          "id": "geometry",
          "valueKind": "object",
          "required": true,
          "displayName": "Geometry"
        },
        {
          "id": "bsp",
          "valueKind": "object",
          "required": true,
          "displayName": "BSP"
        },
        {
          "id": "reject",
          "valueKind": "array",
          "required": true,
          "displayName": "Reject Table"
