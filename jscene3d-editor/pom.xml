<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.glynch</groupId>
        <artifactId>jscene3d-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>jscene3d-editor</artifactId>
    <name>JScene3D Editor</name>
    <description>Native JavaFX visual editor for JScene3D projects.</description>

    <properties>
        <!-- jpackage requires the first macOS bundle-version component to be positive. -->
        <jscene3d.editor.bundleVersion>1.0.0</jscene3d.editor.bundleVersion>
        <jscene3d.editor.distributionDirectory>${project.build.directory}/distribution</jscene3d.editor.distributionDirectory>
        <jscene3d.editor.diskImage>${jscene3d.editor.distributionDirectory}/jscene3d-editor-${jscene3d.editor.bundleVersion}-macos-arm64.dmg</jscene3d.editor.diskImage>
        <jscene3d.editor.generatedDiskImage>${jscene3d.editor.distributionDirectory}/JScene3D Editor-${jscene3d.editor.bundleVersion}.dmg</jscene3d.editor.generatedDiskImage>
        <jscene3d.editor.icon>${project.basedir}/src/main/packaging/jscene3d-editor.icns</jscene3d.editor.icon>
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.github.glynch</groupId>
            <artifactId>jscene3d-editor-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.glynch</groupId>
            <artifactId>jscene3d-game</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.glynch</groupId>
            <artifactId>jscene3d-project-import</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.glynch</groupId>
            <artifactId>jscene3d-project-3d</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.glynch</groupId>
            <artifactId>jscene3d-project-physics</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.glynch</groupId>
            <artifactId>jscene3d-doom</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.github.glynch</groupId>
            <artifactId>jscene3d-lwjgl</artifactId>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-graphics</artifactId>
        </dependency>
        <dependency>
            <groupId>com.huskerdev</groupId>
            <artifactId>openglfx-lwjgl</artifactId>
        </dependency>
        <dependency>
            <groupId>org.lwjgl</groupId>
            <artifactId>lwjgl</artifactId>
            <classifier>${lwjgl.natives}</classifier>
        </dependency>
        <dependency>
            <groupId>org.lwjgl</groupId>
            <artifactId>lwjgl-opengl</artifactId>
            <classifier>${lwjgl.natives}</classifier>
        </dependency>
        <dependency>
            <groupId>org.jspecify</groupId>
            <artifactId>jspecify</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <configuration>
                    <propertiesEncoding>UTF-8</propertiesEncoding>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>editor-distribution-macos-arm64</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-enforcer-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>enforce-editor-macos-arm64-distribution-host</id>
                                <phase>validate</phase>
                                <goals>
                                    <goal>enforce</goal>
                                </goals>
                                <configuration>
                                    <rules>
                                        <requireOS>
                                            <family>mac</family>
                                            <arch>aarch64</arch>
                                        </requireOS>
                                    </rules>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-dependency-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>collect-macos-arm64-editor-runtime</id>
                                <phase>prepare-package</phase>
                                <goals>
                                    <goal>copy-dependencies</goal>
                                </goals>
                                <configuration>
                                    <includeScope>runtime</includeScope>
                                    <outputDirectory>${project.build.directory}/jpackage-input-macos-arm64</outputDirectory>
                                    <overWriteSnapshots>true</overWriteSnapshots>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-resources-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>copy-macos-arm64-editor-jar</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>copy-resources</goal>
                                </goals>
                                <configuration>
                                    <outputDirectory>${project.build.directory}/jpackage-input-macos-arm64</outputDirectory>
                                    <resources>
                                        <resource>
                                            <directory>${project.build.directory}</directory>
                                            <filtering>false</filtering>
                                            <includes>
                                                <include>${project.build.finalName}.jar</include>
                                            </includes>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.panteleyev</groupId>
                        <artifactId>jpackage-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>create-macos-arm64-editor</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>jpackage</goal>
                                </goals>
                                <configuration>
                                    <type>APP_IMAGE</type>
                                    <name>JScene3D Editor</name>
                                    <appVersion>${jscene3d.editor.bundleVersion}</appVersion>
                                    <vendor>JScene3D</vendor>
                                    <description>Visual editor for JScene3D projects.</description>
                                    <copyright>Copyright 2026 Graham Lynch</copyright>
                                    <modulePaths>
                                        <path>${project.build.directory}/jpackage-input-macos-arm64</path>
                                    </modulePaths>
                                    <module>io.github.glynch.jscene3d.editor/io.github.glynch.jscene3d.editor.EditorLauncher</module>
                                    <destination>${project.build.directory}/jpackage-macos-arm64</destination>
                                    <removeDestination>true</removeDestination>
                                    <icon>${jscene3d.editor.icon}</icon>
                                    <addModules>
                                        <module>java.base</module>
                                        <module>java.desktop</module>
                                        <module>java.logging</module>
                                        <module>java.management</module>
                                        <module>java.naming</module>
                                        <module>java.prefs</module>
                                        <module>java.sql</module>
                                        <module>java.xml</module>
                                        <module>io.github.glynch.jscene3d.doom</module>
                                        <module>jdk.incubator.vector</module>
                                        <module>jdk.unsupported</module>
                                    </addModules>
                                    <jLink>
                                        <noHeaderFiles>true</noHeaderFiles>
                                        <noManPages>true</noManPages>
                                        <stripDebug>true</stripDebug>
                                    </jLink>
                                    <javaOptions>
                                        <option>--add-exports=javafx.graphics/com.sun.prism=openglfx</option>
                                        <option>--add-exports=javafx.graphics/com.sun.javafx.scene.layout=openglfx</option>
                                        <option>--add-exports=javafx.graphics/com.sun.javafx.scene=openglfx</option>
                                        <option>--add-exports=javafx.graphics/com.sun.javafx.sg.prism=openglfx</option>
                                        <option>--add-exports=javafx.graphics/com.sun.scenario=openglfx</option>
                                        <option>--add-exports=javafx.graphics/com.sun.javafx.tk=openglfx</option>
                                        <option>--add-exports=javafx.graphics/com.sun.glass.ui=openglfx</option>
                                    </javaOptions>
                                    <macAppCategory>developer-tools</macAppCategory>
                                    <macPackageIdentifier>io.github.glynch.jscene3d.editor</macPackageIdentifier>
                                    <macPackageName>JScene3D Editor</macPackageName>
                                </configuration>
                            </execution>
                            <execution>
                                <id>create-macos-arm64-editor-disk-image</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>jpackage</goal>
                                </goals>
                                <configuration>
                                    <type>DMG</type>
                                    <appVersion>${jscene3d.editor.bundleVersion}</appVersion>
                                    <appImage>${project.build.directory}/jpackage-macos-arm64/JScene3D Editor.app</appImage>
                                    <destination>${jscene3d.editor.distributionDirectory}</destination>
                                    <removeDestination>true</removeDestination>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>rename-macos-arm64-editor-disk-image</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>/bin/mv</executable>
                                    <arguments>
                                        <argument>${jscene3d.editor.generatedDiskImage}</argument>
                                        <argument>${jscene3d.editor.diskImage}</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <execution>
                                <id>verify-macos-arm64-editor-code-signature</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>/usr/bin/codesign</executable>
                                    <arguments>
                                        <argument>--verify</argument>
                                        <argument>--deep</argument>
                                        <argument>--strict</argument>
                                        <argument>${project.build.directory}/jpackage-macos-arm64/JScene3D Editor.app</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <execution>
                                <id>verify-macos-arm64-editor-disk-image</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>/usr/bin/hdiutil</executable>
                                    <arguments>
                                        <argument>verify</argument>
                                        <argument>${jscene3d.editor.diskImage}</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>prepare-editor-run</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-dependency-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>collect-editor-runtime-modules</id>
                                <phase>prepare-package</phase>
                                <goals>
                                    <goal>copy-dependencies</goal>
                                </goals>
                                <configuration>
                                    <includeScope>runtime</includeScope>
                                    <outputDirectory>${project.build.directory}/editor-module-path</outputDirectory>
                                    <overWriteSnapshots>true</overWriteSnapshots>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
