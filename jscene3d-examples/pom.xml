<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.glynch</groupId>
        <artifactId>jscene3d-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>jscene3d-examples</artifactId>
    <name>JScene3D Examples</name>
    <description>Runnable feature and integration examples for JScene3D.</description>

    <properties>
        <jacoco.skip>true</jacoco.skip>
        <jscene3d.examples.natives>${lwjgl.natives}</jscene3d.examples.natives>
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.github.glynch</groupId>
            <artifactId>jscene3d-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.glynch</groupId>
            <artifactId>jscene3d-lwjgl</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.glynch</groupId>
            <artifactId>jscene3d-gui</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.glynch</groupId>
            <artifactId>jscene3d-gltf</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.glynch</groupId>
            <artifactId>jscene3d-example-framework</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jspecify</groupId>
            <artifactId>jspecify</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.lwjgl</groupId>
            <artifactId>lwjgl</artifactId>
            <classifier>${jscene3d.examples.natives}</classifier>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.lwjgl</groupId>
            <artifactId>lwjgl-glfw</artifactId>
            <classifier>${jscene3d.examples.natives}</classifier>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.lwjgl</groupId>
            <artifactId>lwjgl-opengl</artifactId>
            <classifier>${jscene3d.examples.natives}</classifier>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.lwjgl</groupId>
            <artifactId>lwjgl-stb</artifactId>
            <classifier>${jscene3d.examples.natives}</classifier>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <profiles>
        <profile>
            <id>example-distribution-macos-arm64</id>
            <properties>
                <!-- jpackage requires the first macOS bundle-version component to be positive. -->
                <jscene3d.examples.bundleVersion>1.0.0</jscene3d.examples.bundleVersion>
                <jscene3d.examples.natives>natives-macos-arm64</jscene3d.examples.natives>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-enforcer-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>enforce-macos-arm64-distribution-host</id>
                                <phase>validate</phase>
                                <goals>
                                    <goal>enforce</goal>
                                </goals>
                                <configuration>
                                    <rules>
                                        <requireOS>
                                            <family>mac</family>
                                            <arch>aarch64</arch>
                                        </requireOS>
                                    </rules>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-resources-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>prepare-macos-arm64-jpackage-input</id>
                                <phase>prepare-package</phase>
                                <goals>
                                    <goal>copy-resources</goal>
                                </goals>
                                <configuration>
                                    <outputDirectory>${project.build.directory}/jpackage-input-macos-arm64</outputDirectory>
                                    <resources>
                                        <resource>
                                            <directory>${maven.multiModuleProjectDirectory}</directory>
                                            <filtering>false</filtering>
                                            <includes>
                                                <include>LICENSE</include>
                                                <include>THIRD_PARTY_NOTICES.md</include>
                                            </includes>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-shade-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>package-macos-arm64-example-browser</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>shade</goal>
                                </goals>
                                <configuration>
                                    <createDependencyReducedPom>false</createDependencyReducedPom>
                                    <outputFile>${project.build.directory}/jpackage-input-macos-arm64/${project.build.finalName}-macos-arm64.jar</outputFile>
                                    <filters>
                                        <filter>
                                            <artifact>*:*</artifact>
                                            <excludes>
                                                <exclude>module-info.class</exclude>
                                                <exclude>META-INF/LICENSE</exclude>
                                                <exclude>META-INF/MANIFEST.MF</exclude>
                                                <exclude>META-INF/versions/**/module-info.class</exclude>
                                                <exclude>META-INF/*.DSA</exclude>
                                                <exclude>META-INF/*.RSA</exclude>
                                                <exclude>META-INF/*.SF</exclude>
                                                <exclude>META-INF/INDEX.LIST</exclude>
                                            </excludes>
                                        </filter>
                                        <filter>
                                            <artifact>org.lwjgl:*:jar:natives-macos-arm64</artifact>
                                            <excludes>
                                                <exclude>**/*.sha1</exclude>
                                            </excludes>
                                        </filter>
                                    </filters>
                                    <transformers>
                                        <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer" />
                                        <transformer implementation="org.apache.maven.plugins.shade.resource.ApacheNoticeResourceTransformer" />
                                        <transformer implementation="org.apache.maven.plugins.shade.resource.IncludeResourceTransformer">
                                            <resource>META-INF/LICENSE</resource>
                                            <file>${maven.multiModuleProjectDirectory}/LICENSE</file>
                                        </transformer>
                                        <transformer implementation="org.apache.maven.plugins.shade.resource.IncludeResourceTransformer">
                                            <resource>META-INF/THIRD_PARTY_NOTICES.md</resource>
                                            <file>${maven.multiModuleProjectDirectory}/THIRD_PARTY_NOTICES.md</file>
                                        </transformer>
                                        <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                            <mainClass>io.github.glynch.jscene3d.examples.ExampleBrowser</mainClass>
                                        </transformer>
                                    </transformers>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.panteleyev</groupId>
                        <artifactId>jpackage-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>create-macos-arm64-example-browser</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>jpackage</goal>
                                </goals>
                                <configuration>
                                    <type>APP_IMAGE</type>
                                    <name>JScene3D Examples</name>
                                    <appVersion>${jscene3d.examples.bundleVersion}</appVersion>
                                    <vendor>JScene3D</vendor>
                                    <description>Interactive examples for the JScene3D rendering library.</description>
                                    <copyright>Copyright 2026 Graham Lynch</copyright>
                                    <input>${project.build.directory}/jpackage-input-macos-arm64</input>
                                    <mainJar>${project.build.finalName}-macos-arm64.jar</mainJar>
                                    <mainClass>io.github.glynch.jscene3d.examples.ExampleBrowser</mainClass>
                                    <destination>${project.build.directory}/jpackage-macos-arm64</destination>
                                    <removeDestination>true</removeDestination>
                                    <addModules>
                                        <module>java.base</module>
                                        <module>java.desktop</module>
                                        <module>java.logging</module>
                                        <module>java.management</module>
                                        <module>java.naming</module>
                                        <module>java.sql</module>
                                        <module>java.xml</module>
                                        <module>jdk.incubator.vector</module>
                                        <module>jdk.unsupported</module>
                                    </addModules>
                                    <jLink>
                                        <noHeaderFiles>true</noHeaderFiles>
                                        <noManPages>true</noManPages>
                                        <stripDebug>true</stripDebug>
                                    </jLink>
                                    <javaOptions>
                                        <option>-XstartOnFirstThread</option>
                                    </javaOptions>
                                    <macAppCategory>developer-tools</macAppCategory>
                                    <macPackageIdentifier>io.github.glynch.jscene3d.examples</macPackageIdentifier>
                                    <macPackageName>JScene3D</macPackageName>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>verify-macos-arm64-bundled-resources</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>${project.build.directory}/jpackage-macos-arm64/JScene3D Examples.app/Contents/runtime/Contents/Home/bin/java</executable>
                                    <arguments>
                                        <argument>-classpath</argument>
                                        <argument>${project.build.testOutputDirectory}:${project.build.directory}/jpackage-macos-arm64/JScene3D Examples.app/Contents/app/${project.build.finalName}-macos-arm64.jar</argument>
                                        <argument>io.github.glynch.jscene3d.examples.BundledResourcesDistributionProbe</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <execution>
                                <id>verify-macos-arm64-first-thread-option</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>/usr/bin/grep</executable>
                                    <arguments>
                                        <argument>-F</argument>
                                        <argument>-q</argument>
                                        <argument>java-options=-XstartOnFirstThread</argument>
                                        <argument>${project.build.directory}/jpackage-macos-arm64/JScene3D Examples.app/Contents/app/JScene3D Examples.cfg</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <execution>
                                <id>verify-macos-arm64-code-signature</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>/usr/bin/codesign</executable>
                                    <arguments>
                                        <argument>--verify</argument>
                                        <argument>--deep</argument>
                                        <argument>--strict</argument>
                                        <argument>${project.build.directory}/jpackage-macos-arm64/JScene3D Examples.app</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-assembly-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>assemble-macos-arm64-example-browser</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>single</goal>
                                </goals>
                                <configuration>
                                    <descriptors>
                                        <descriptor>src/assembly/macos-arm64.xml</descriptor>
                                    </descriptors>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>run-example</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>run-selected-example</id>
                                <phase>compile</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>${java.home}/bin/java</executable>
                                    <arguments>
                                        <argument>${jscene3d.example.firstThreadArgument}</argument>
                                        <argument>-Djscene3d.thumbnailSelection=${jscene3d.thumbnailSelection}</argument>
                                        <argument>-classpath</argument>
                                        <classpath />
                                        <argument>${jscene3d.exampleMainClass}</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
