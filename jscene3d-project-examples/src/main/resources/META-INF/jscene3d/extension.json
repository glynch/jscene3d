{
  "schemaVersion": 1,
  "id": "io.github.glynch.jscene3d.import-example",
  "version": "1.0.0",
  "engineRequires": ">=0.1.0-SNAPSHOT <0.2.0",
  "displayName": "Project Import Example",
  "types": [
    {
      "id": "io.github.glynch.jscene3d.import-example/source-text",
      "typeVersion": 1,
      "scope": "resource",
      "displayName": "Source Text"
    },
    {
      "id": "io.github.glynch.jscene3d.import-example/text-importer",
      "typeVersion": 1,
      "scope": "importer",
      "displayName": "Text Importer",
      "properties": [
        {
          "id": "uppercase",
          "valueKind": "boolean",
          "defaultValue": true,
          "displayName": "Uppercase"
        }
      ]
    },
    {
      "id": "io.github.glynch.jscene3d.import-example/imported-text",
      "typeVersion": 1,
      "scope": "resource",
      "displayName": "Imported Text",
      "properties": [
        {
          "id": "content-base64",
          "valueKind": "text",
          "required": true,
          "displayName": "Base64 Content"
        }
      ]
    },
    {
      "id": "io.github.glynch.jscene3d.import-example/text-consumer-3d",
      "typeVersion": 1,
      "scope": "scene-node",
      "displayName": "Text Consumer 3d",
      "properties": [
        {
          "id": "text",
          "valueKind": "reference",
          "required": true,
          "displayName": "Text",
          "acceptedReferences": ["import"]
        }
      ]
    }
  ]
