    {
      "id": "io.github.glynch.jscene3d/sphere-shape-3d",
      "typeVersion": 1,
      "scope": "resource",
      "displayName": "Sphere Shape 3d",
      "properties": [
        {
          "id": "radius",
          "valueKind": "number",
          "defaultValue": 0.5,
