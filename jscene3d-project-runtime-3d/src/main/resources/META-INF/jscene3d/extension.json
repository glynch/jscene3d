        {
          "id": "mask-bits",
          "valueKind": "number",
          "defaultValue": -1,
          "displayName": "Mask Bits",
          "editor": {"section": "Collision", "integer": true}
        }
      ]
    },
    {
      "id": "io.github.glynch.jscene3d/box-geometry-3d",
      "typeVersion": 1,
      "scope": "resource",
      "displayName": "Box Geometry 3d",
      "properties": [
        {
          "id": "width",
          "valueKind": "number",
          "defaultValue": 1,
          "displayName": "Width",
          "editor": {"minimumExclusive": 0}
        },
        {
          "id": "height",
          "valueKind": "number",
          "defaultValue": 1,
          "displayName": "Height",
          "editor": {"minimumExclusive": 0}
        },
        {
          "id": "depth",
          "valueKind": "number",
          "defaultValue": 1,
          "displayName": "Depth",
          "editor": {"minimumExclusive": 0}
        }
      ]
