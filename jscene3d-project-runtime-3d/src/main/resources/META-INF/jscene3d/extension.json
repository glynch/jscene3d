{
  "schemaVersion": 1,
  "id": "io.github.glynch.jscene3d",
  "version": "0.1.0-SNAPSHOT",
  "engineRequires": ">=0.1.0-SNAPSHOT <0.2.0",
  "displayName": "JScene3D Native 3d",
  "types": [
    {
      "id": "io.github.glynch.jscene3d/group-3d",
      "typeVersion": 1,
      "scope": "scene-node",
      "displayName": "Group 3d",
      "properties": [
        {
          "id": "position",
          "valueKind": "array",
          "defaultValue": [0, 0, 0],
          "displayName": "Position",
          "editor": {"section": "Transform", "elementCount": 3}
        },
        {
          "id": "rotation-degrees",
          "valueKind": "array",
          "defaultValue": [0, 0, 0],
          "displayName": "Rotation",
          "editor": {"section": "Transform", "elementCount": 3, "unit": "degrees"}
        },
        {
          "id": "scale",
          "valueKind": "array",
          "defaultValue": [1, 1, 1],
          "displayName": "Scale",
          "editor": {"section": "Transform", "elementCount": 3}
        },
        {
          "id": "background",
          "valueKind": "text",
          "defaultValue": "#101820",
          "displayName": "Background",
          "editor": {"section": "World", "control": "color"}
        }
      ]
    },
    {
      "id": "io.github.glynch.jscene3d/mesh-instance-3d",
      "typeVersion": 1,
      "scope": "scene-node",
      "displayName": "Mesh Instance 3d",
      "properties": [
        {
          "id": "geometry",
          "valueKind": "reference",
          "required": true,
          "displayName": "Geometry",
          "acceptedReferences": ["project"]
        },
        {
          "id": "material",
          "valueKind": "reference",
          "required": true,
          "displayName": "Material",
          "acceptedReferences": ["project"]
        },
        {
          "id": "position",
          "valueKind": "array",
          "defaultValue": [0, 0, 0],
          "displayName": "Position",
          "editor": {"section": "Transform", "elementCount": 3}
        },
        {
          "id": "rotation-degrees",
          "valueKind": "array",
          "defaultValue": [0, 0, 0],
          "displayName": "Rotation",
          "editor": {"section": "Transform", "elementCount": 3, "unit": "degrees"}
        },
        {
          "id": "scale",
          "valueKind": "array",
          "defaultValue": [1, 1, 1],
          "displayName": "Scale",
          "editor": {"section": "Transform", "elementCount": 3}
        }
      ]
    },
    {
      "id": "io.github.glynch.jscene3d/perspective-camera-3d",
      "typeVersion": 1,
      "scope": "scene-node",
      "displayName": "Perspective Camera 3d",
      "properties": [
        {
          "id": "position",
          "valueKind": "array",
          "defaultValue": [0, 0, 5],
          "displayName": "Position",
          "editor": {"section": "Transform", "elementCount": 3}
        },
        {
          "id": "scale",
          "valueKind": "array",
          "defaultValue": [1, 1, 1],
          "displayName": "Scale",
          "editor": {"section": "Transform", "elementCount": 3}
        },
        {
          "id": "target",
          "valueKind": "array",
          "defaultValue": [0, 0, 0],
          "displayName": "Target",
          "editor": {"section": "Camera", "elementCount": 3}
        },
        {
          "id": "field-of-view-degrees",
          "valueKind": "number",
          "defaultValue": 60,
          "displayName": "Field of View",
          "editor": {"section": "Camera", "minimum": 1, "maximum": 179, "unit": "degrees"}
        },
        {
          "id": "near",
          "valueKind": "number",
          "defaultValue": 0.1,
          "displayName": "Near",
          "editor": {"section": "Camera", "minimumExclusive": 0}
        },
        {
          "id": "far",
          "valueKind": "number",
          "defaultValue": 1000,
          "displayName": "Far",
          "editor": {"section": "Camera", "minimumExclusive": 0}
        },
        {
          "id": "active",
          "valueKind": "boolean",
          "defaultValue": true,
          "displayName": "Active",
          "editor": {"section": "Camera"}
        }
      ]
    },
    {
      "id": "io.github.glynch.jscene3d/ambient-light-3d",
      "typeVersion": 1,
      "scope": "scene-node",
      "displayName": "Ambient Light 3d",
      "properties": [
        {
          "id": "color",
          "valueKind": "text",
          "defaultValue": "#ffffff",
          "displayName": "Color",
          "editor": {"control": "color"}
        },
        {
          "id": "intensity",
          "valueKind": "number",
          "defaultValue": 0.35,
          "displayName": "Intensity",
          "editor": {"minimum": 0}
        }
      ]
    },
    {
      "id": "io.github.glynch.jscene3d/static-body-3d",
      "typeVersion": 1,
      "scope": "scene-node",
      "displayName": "Static Body 3d",
      "properties": [
        {
          "id": "position",
          "valueKind": "array",
          "defaultValue": [0, 0, 0],
          "displayName": "Position",
          "editor": {"section": "Transform", "elementCount": 3}
        },
        {
          "id": "rotation-degrees",
          "valueKind": "array",
          "defaultValue": [0, 0, 0],
          "displayName": "Rotation",
          "editor": {"section": "Transform", "elementCount": 3, "unit": "degrees"}
        }
      ]
    },
    {
      "id": "io.github.glynch.jscene3d/character-body-3d",
      "typeVersion": 1,
      "scope": "scene-node",
      "displayName": "Character Body 3d",
      "description": "A kinematic character body with sliding, stepping, gravity, and ground snapping.",
      "properties": [
        {
          "id": "position",
          "valueKind": "array",
          "defaultValue": [0, 0, 0],
          "displayName": "Position",
          "editor": {"section": "Transform", "elementCount": 3}
        },
        {
          "id": "rotation-degrees",
          "valueKind": "array",
          "defaultValue": [0, 0, 0],
          "displayName": "Rotation",
          "editor": {"section": "Transform", "elementCount": 3, "unit": "degrees"}
        },
        {
          "id": "up",
          "valueKind": "array",
          "defaultValue": [0, 1, 0],
          "displayName": "Up",
          "editor": {"section": "Movement", "elementCount": 3}
        },
        {
          "id": "gravity",
          "valueKind": "number",
          "defaultValue": 18,
          "displayName": "Gravity",
          "editor": {"section": "Movement", "minimum": 0}
        },
        {
          "id": "jump-speed",
          "valueKind": "number",
          "defaultValue": 7,
          "displayName": "Jump Speed",
          "editor": {"section": "Movement", "minimum": 0}
        },
        {
          "id": "skin-width",
          "valueKind": "number",
          "defaultValue": 0.001,
          "displayName": "Skin Width",
          "editor": {"section": "Collision", "minimum": 0}
        },
        {
          "id": "maximum-slide-iterations",
          "valueKind": "number",
          "defaultValue": 4,
          "displayName": "Maximum Slide Iterations",
          "editor": {"section": "Collision", "integer": true, "minimum": 1}
        },
        {
          "id": "maximum-step-height",
          "valueKind": "number",
          "defaultValue": 0.5,
          "displayName": "Maximum Step Height",
          "editor": {"section": "Movement", "minimum": 0}
        },
        {
          "id": "ground-snap-distance",
          "valueKind": "number",
          "defaultValue": 0.1,
          "displayName": "Ground Snap Distance",
          "editor": {"section": "Movement", "minimum": 0}
        },
        {
          "id": "maximum-slope-angle-degrees",
          "valueKind": "number",
          "defaultValue": 50,
          "displayName": "Maximum Slope Angle",
          "editor": {"section": "Movement", "minimum": 0, "maximumExclusive": 90, "unit": "degrees"}
        }
      ]
    },
    {
      "id": "io.github.glynch.jscene3d/collision-shape-3d",
      "typeVersion": 1,
      "scope": "scene-node",
      "displayName": "Collision Shape 3d",
      "properties": [
        {
          "id": "shape",
          "valueKind": "reference",
          "required": true,
          "displayName": "Shape",
          "acceptedReferences": ["project", "import"]
