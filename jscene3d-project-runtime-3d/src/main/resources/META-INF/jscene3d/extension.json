    {
      "id": "io.github.glynch.jscene3d/lambert-material-3d",
      "typeVersion": 1,
      "scope": "resource",
      "displayName": "Lambert Material 3d",
      "properties": [
        {
          "id": "color",
          "valueKind": "text",
          "defaultValue": "#4fc3f7",
