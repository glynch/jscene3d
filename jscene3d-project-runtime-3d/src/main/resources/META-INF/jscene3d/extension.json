        {
          "id": "position",
          "valueKind": "array",
          "defaultValue": [0, 0, 0],
          "displayName": "Position",
          "editor": {"section": "Transform", "elementCount": 3}
        },
        {
          "id": "rotation-degrees",
          "valueKind": "array",
          "defaultValue": [0, 0, 0],
          "displayName": "Rotation",
          "editor": {"section": "Transform", "elementCount": 3, "unit": "degrees"}
        },
        {
          "id": "category-bits",
          "valueKind": "number",
          "defaultValue": 1,
          "displayName": "Category Bits",
          "editor": {"section": "Collision", "integer": true}
