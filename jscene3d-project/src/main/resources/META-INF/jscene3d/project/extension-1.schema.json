{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jscene3d.org/schemas/extension-1.json",
  "title": "JScene3D Extension Descriptor version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "engineRequires",
    "displayName",
    "types"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri-reference"
    },
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/extensionId"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "engineRequires": {
      "type": "string",
      "minLength": 1
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "types": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/registeredTypeDescriptor"
      }
    },
    "components": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/componentTypeDescriptor"
      }
    },
    "settings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/setting"
      }
    }
  },
  "$defs": {
    "extensionId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*)+$"
    },
    "localId": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
    },
    "registeredTypeId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z0-9][a-z0-9-]*)+/[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
    },
    "presentation": {
      "type": "object",
      "properties": {
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "displayName"
      ]
    },
    "registeredTypeDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "typeVersion",
        "scope",
        "displayName"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/registeredTypeId"
        },
        "typeVersion": {
          "type": "integer",
          "minimum": 1
        },
        "scope": {
          "enum": [
            "scene-node",
            "node-controller",
            "project-system",
            "resource",
            "importer"
          ]
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "properties": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/property"
          }
        },
        "signals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/endpoint"
          }
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/endpoint"
          }
        },
        "requiredCapabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/registeredTypeId"
          },
          "uniqueItems": true
        }
      }
    },
    "componentTypeDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "typeVersion",
        "displayName"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/registeredTypeId"
        },
        "typeVersion": {
          "type": "integer",
          "minimum": 1
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "properties": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/property"
          }
        },
        "signals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/endpoint"
          }
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/endpoint"
          }
        },
        "providedCapabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/registeredTypeId"
          },
          "uniqueItems": true
        },
        "requiredCapabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/registeredTypeId"
          },
          "uniqueItems": true
        },
        "attachments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/localId"
          },
          "uniqueItems": true
        },
        "multiplicity": {
          "enum": [
            "single",
            "multiple"
          ],
          "default": "single"
        },
        "conflicts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/registeredTypeId"
          },
          "uniqueItems": true
        },
        "spatialDomain": {
          "enum": [
            "none",
            "three-dimensional",
            "two-dimensional",
            "user-interface"
          ],
          "default": "none"
        },
        "lifecycle": {
          "type": "array",
          "items": {
            "enum": [
              "created",
              "activated",
              "deactivated",
              "destroyed"
            ]
          },
          "uniqueItems": true
        },
        "updatePhases": {
          "type": "array",
          "items": {
            "enum": [
              "before-physics",
              "after-physics",
              "frame-update"
            ]
          },
          "uniqueItems": true
        }
      }
    },
    "setting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "type",
        "defaultValue",
        "displayName",
        "category",
        "scope"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*)+$"
        },
        "type": {
          "enum": ["boolean", "integer", "number", "string", "path", "enum"]
        },
        "defaultValue": {},
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "const": "project"
        },
        "order": {
          "type": "integer"
        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        },
        "step": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "choices": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/settingChoice"
          }
        },
        "pathKind": {
          "enum": ["file", "directory"]
        },
        "projectRelative": {
          "type": "boolean"
        }
      }
    },
    "settingChoice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "label"],
      "properties": {
        "value": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "property": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "valueKind",
        "displayName"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/localId"
        },
        "valueKind": {
          "enum": [
            "null",
            "boolean",
            "number",
            "text",
            "array",
            "object",
            "reference",
            "entity_target",
            "component_target"
          ]
        },
        "elementKind": {
          "enum": [
            "null",
            "boolean",
            "number",
            "text",
            "array",
            "object",
            "reference",
            "entity_target",
            "component_target"
          ]
        },
        "required": {
          "type": "boolean",
          "default": false
        },
        "defaultValue": true,
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "editor": {
          "type": "object"
        },
        "acceptedReferences": {
          "type": "array",
          "items": {
            "enum": [
              "project",
              "asset",
              "import"
            ]
          },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "elementKind"
            ]
          },
          "then": {
            "properties": {
              "valueKind": {
                "const": "array"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "required": {
                "const": true
              }
            },
            "required": [
              "required"
            ]
          },
          "then": {
            "not": {
              "required": [
                "defaultValue"
              ]
            }
          }
        },
        {
          "if": {
            "required": [
              "acceptedReferences"
            ]
          },
          "then": {
            "properties": {
              "valueKind": {
                "const": "reference"
              }
            }
          }
        }
      ]
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "displayName"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/localId"
        },
        "payload": {
          "$ref": "#/$defs/registeredType"
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "registeredType": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "typeVersion"
      ],
      "properties": {
        "type": {
          "$ref": "#/$defs/registeredTypeId"
        },
        "typeVersion": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
