{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jscene3d.org/schemas/extension-1.json",
  "title": "JScene3D Extension Descriptor version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "engineRequires",
    "displayName",
    "types"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri-reference"
    },
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/extensionId"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "engineRequires": {
      "type": "string",
      "minLength": 1
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "types": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/registeredTypeDescriptor"
      }
    }
  },
  "$defs": {
    "extensionId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*)+$"
    },
    "localId": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
    },
    "registeredTypeId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z0-9][a-z0-9-]*)+/[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
    },
    "presentation": {
      "type": "object",
      "properties": {
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "displayName"
      ]
    },
    "registeredTypeDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "typeVersion",
        "scope",
        "displayName"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/registeredTypeId"
        },
        "typeVersion": {
          "type": "integer",
          "minimum": 1
        },
        "scope": {
          "enum": [
            "scene-node",
            "node-controller",
            "project-system",
            "resource",
            "importer"
          ]
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "properties": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/property"
          }
        },
        "signals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/endpoint"
          }
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/endpoint"
          }
        },
        "requiredCapabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/registeredTypeId"
          },
          "uniqueItems": true
        }
      }
    },
    "property": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "valueKind",
        "displayName"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/localId"
        },
        "valueKind": {
          "enum": [
            "null",
            "boolean",
            "number",
            "text",
            "array",
            "object",
            "reference"
          ]
        },
        "required": {
          "type": "boolean",
          "default": false
        },
        "defaultValue": true,
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "editor": {
          "type": "object"
        },
        "acceptedReferences": {
          "type": "array",
          "items": {
            "enum": [
              "project",
              "asset",
              "import"
            ]
          },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "required": {
                "const": true
              }
            },
            "required": [
              "required"
            ]
          },
          "then": {
            "not": {
              "required": [
                "defaultValue"
              ]
            }
          }
        },
        {
          "if": {
            "required": [
              "acceptedReferences"
            ]
          },
          "then": {
            "properties": {
              "valueKind": {
                "const": "reference"
              }
            }
          }
        }
      ]
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "displayName"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/localId"
        },
        "payload": {
          "$ref": "#/$defs/registeredType"
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "registeredType": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "typeVersion"
      ],
      "properties": {
        "type": {
          "$ref": "#/$defs/registeredTypeId"
        },
        "typeVersion": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
