{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jscene3d.org/schemas/input-map-1.json",
  "title": "JScene3D Input Map version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "actions"],
  "properties": {
    "$schema": {"type": "string", "format": "uri-reference"},
    "schemaVersion": {"const": 1},
    "actions": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"},
      "additionalProperties": {"$ref": "#/$defs/action"}
    }
  },
  "$defs": {
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["valueType", "bindings"],
      "properties": {
        "valueType": {"enum": ["button", "axis-1d", "axis-2d"]},
        "bindings": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/binding"}
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["device", "control"],
      "properties": {
        "device": {"enum": ["keyboard", "mouse", "gamepad"]},
        "control": {"type": "string", "minLength": 1},
        "up": {"type": "string", "minLength": 1},
        "down": {"type": "string", "minLength": 1},
        "left": {"type": "string", "minLength": 1},
        "right": {"type": "string", "minLength": 1},
        "deadZone": {"type": "number", "minimum": 0, "exclusiveMaximum": 1},
        "scale": {"type": "number"},
        "scaleX": {"type": "number"},
        "scaleY": {"type": "number"},
        "invertY": {"type": "boolean"}
      }
    }
  }
}
