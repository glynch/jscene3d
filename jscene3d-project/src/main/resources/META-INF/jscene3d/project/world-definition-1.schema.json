{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jscene3d.org/schemas/world-definition-1.json",
  "title": "JScene3D World Definition version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["assetId", "assetType", "formatVersion", "name", "roots"],
  "properties": {
    "$schema": {"type": "string", "format": "uri"},
    "assetId": {"type": "string", "format": "uuid"},
    "assetType": {"const": "world-definition"},
    "formatVersion": {"const": 1},
    "name": {"type": "string", "minLength": 1},
    "roots": {
      "type": "array",
      "items": {"$ref": "entity-definition-1.schema.json#/$defs/entry"}
    }
  }
}
